# Copy this file to `.env` in the same directory and fill in the value.
# DO NOT commit `.env` — it is gitignored.
#
# Get your connection string from MongoDB Atlas:
#   Database → Connect → Drivers → Node.js
# Then:
#   1. Replace <db_password> with your database user's password
#   2. Strip everything from `?` to the end of the URL
#   3. Keep the trailing `/` — the backend appends the db name
#
# Example shape (do not use these values):
# MONGO_CONNECTION_STRING=mongodb+srv://your-user:your-password@cluster0.xxxxx.mongodb.net/

MONGO_CONNECTION_STRING=

# Shared with auth (login/signup). Same value for all devs in Postman testing.
# Generate a long random string, e.g. openssl rand -hex 32
JWT_SECRET=

# Postman (until /auth/login exists):
#   node scripts/sign-test-jwt.js test-user-a
# Then: Authorization: Bearer <printed token>
